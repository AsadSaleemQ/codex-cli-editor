{
  "name": "codex-cli-editor",
  "displayName": "Codex CLI Editor",
  "description": "Codex CLI Editor turns enhanced Codex terminals into chat-style editors while preserving native behavior everywhere else.",
  "version": "0.4.1",
  "publisher": "asadsaleemq",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AsadSaleemQ/codex-cli-editor.git"
  },
  "homepage": "https://github.com/AsadSaleemQ/codex-cli-editor#readme",
  "bugs": {
    "url": "https://github.com/AsadSaleemQ/codex-cli-editor/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "keywords": ["codex", "terminal", "chat", "clipboard"],
  "activationEvents": [
    "onCommand:codexCliEditor.promptHome",
    "onCommand:codexCliEditor.promptEnd",
    "onCommand:codexCliEditor.smartPaste"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "codexCliEditor.promptHome", "title": "Codex CLI Editor: Prompt Start" },
      { "command": "codexCliEditor.promptEnd", "title": "Codex CLI Editor: Prompt End" },
      { "command": "codexCliEditor.smartPaste", "title": "Codex CLI Editor: Smart Paste" }
    ],
    "keybindings": [
      { "command": "codexCliEditor.promptHome", "key": "ctrl+home", "when": "terminalFocus" },
      { "command": "codexCliEditor.promptEnd", "key": "ctrl+end", "when": "terminalFocus" },
      { "command": "codexCliEditor.smartPaste", "key": "ctrl+v", "when": "terminalFocus" }
    ]
  }
}
