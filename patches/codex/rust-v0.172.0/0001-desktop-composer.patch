+            .join(",");
+        let record = format!(
+            "{{\"schema_version\":1,\"pid\":{},\"console_pids\":[{}],\"prompt_active\":{}}}\n",
+            std::process::id(),
+            ids,
+            active
+        );
+        if std::fs::write(path, record).is_ok() {
+            *last = Some(active);
+        }
+    }
+
+    pub(super) fn finish() {
+        let Some(slot) = RECORD.get() else {
+            return;
+        };
+        let Ok(path) = slot.lock() else {
+            return;
+        };
+        if let Some(path) = path.as_ref() {
+            let _ = std::fs::remove_file(path);
+        }
+    }
+}
+
+pub(crate) fn set_prompt_active(active: bool) {
+    #[cfg(windows)]
+    platform::set_prompt_active(active);
+    #[cfg(not(windows))]
+    let _ = active;
+}
+
+pub(crate) fn finish() {
+    #[cfg(windows)]
+    platform::finish();
+}
