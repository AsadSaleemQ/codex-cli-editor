+                        range.start
+                    } else {
+                        range.end
+                    });
+                }
+                _ => return false,
+            }
+            return true;
+        }
+        let anchor = if select_all { 0 } else { anchor };
+        self.mouse_selection = (self.cursor_pos != anchor).then_some(MouseSelection {
