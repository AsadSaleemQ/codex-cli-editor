+use std::ops::Range;
+
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub(super) struct Selection {
+    anchor: Option<usize>,
+}
+
+impl Selection {
+    pub(super) fn clear(&mut self) {
+        self.anchor = None;
+    }
+
+    pub(super) fn anchor(self) -> Option<usize> {
+        self.anchor
+    }
+
+    pub(super) fn set_anchor(&mut self, anchor: usize) {
+        self.anchor = Some(anchor);
+    }
+
+    pub(super) fn range(self, cursor: usize) -> Option<Range<usize>> {
+        let anchor = self.anchor?;
+        let range = anchor.min(cursor)..anchor.max(cursor);
+        (range.start < range.end).then_some(range)
+    }
+
+    pub(super) fn clear_if_empty(&mut self, cursor: usize) {
+        if self.anchor == Some(cursor) {
+            self.clear();
+        }
+    }
+}
