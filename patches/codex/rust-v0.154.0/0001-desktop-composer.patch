new file mode 100644
index 0000000000000000000000000000000000000000..ca34a68642085848629245556c3c18c5e96ac757
--- /dev/null
+++ b/codex-rs/tui/src/vscode_bridge.rs
@@ -0,0 +1,85 @@
+#[cfg(windows)]
+mod platform {
+    use std::path::PathBuf;
+    use std::sync::Mutex;
+    use std::sync::OnceLock;
+
+    use windows_sys::Win32::System::Console::GetConsoleProcessList;
+
+    static RECORD: OnceLock<Mutex<Option<PathBuf>>> = OnceLock::new();
+
+    fn record_path() -> Option<PathBuf> {
+        if std::env::var("TERM_PROGRAM").ok().as_deref() != Some("vscode") {
+            return None;
+        }
+        let root = PathBuf::from(std::env::var_os("LOCALAPPDATA")?)
+            .join("CodexCLIEditor")
+            .join("vscode-bridge");
+        std::fs::create_dir_all(&root).ok()?;
+        Some(root.join(format!("{}.json", std::process::id())))
+    }
+
+    fn console_process_ids() -> Vec<u32> {
+        let mut ids = vec![0_u32; 32];
+        loop {
+            let count =
+                unsafe { GetConsoleProcessList(ids.as_mut_ptr(), ids.len() as u32) } as usize;
+            if count == 0 {
+                return vec![std::process::id()];
+            }
+            if count <= ids.len() {
+                ids.truncate(count);
+                ids.sort_unstable();
+                ids.dedup();
+                return ids;
+            }
+            ids.resize(count, 0);
+        }
+    }
+
+    pub(super) fn set_prompt_active(active: bool) {
+        let slot = RECORD.get_or_init(|| Mutex::new(record_path()));
+        let Ok(path) = slot.lock() else {
+            return;
+        };
+        let Some(path) = path.as_ref() else {
+            return;
+        };
+        let ids = console_process_ids()
+            .into_iter()
+            .map(|pid| pid.to_string())
+            .collect::<Vec<_>>()
+            .join(",");
+        let record = format!(
+            "{{\"schema_version\":1,\"pid\":{},\"console_pids\":[{}],\"prompt_active\":{}}}\n",
+            std::process::id(),
+            ids,
+            active
+        );
+        let _ = std::fs::write(path, record);
+    }
+
+    pub(super) fn finish() {
+        let Some(slot) = RECORD.get() else {
+            return;
+        };
+        let Ok(path) = slot.lock() else {
+            return;
+        };
+        if let Some(path) = path.as_ref() {
+            let _ = std::fs::remove_file(path);
+        }
+    }
+}
+
+pub(crate) fn set_prompt_active(active: bool) {
+    #[cfg(windows)]
+    platform::set_prompt_active(active);
+    #[cfg(not(windows))]
+    let _ = active;
+}
+
+pub(crate) fn finish() {
+    #[cfg(windows)]
+    platform::finish();
+}
