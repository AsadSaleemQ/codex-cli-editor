+async fn rendered_chat_widget_routes_mouse_clicks_to_the_composer() -> Result<()> {
+    let mut app = make_test_app().await;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.chat_widget.handle_paste("abcdef".to_string());
+
+    let screen_size = tui.terminal.last_known_screen_size;
+    let rendered_area = app.render_chat_widget_frame(&mut tui, screen_size)?;
+    let (cursor_x, cursor_y) = app
+        .chat_widget
+        .as_renderable()
+        .cursor_pos(rendered_area)
+        .expect("composer cursor should be visible after rendering");
+
+    assert!(
+        app.chat_widget
+            .handle_mouse_event(crossterm::event::MouseEvent {
+                kind: crossterm::event::MouseEventKind::Down(crossterm::event::MouseButton::Left),
+                column: cursor_x.saturating_sub(3),
+                row: cursor_y,
+                modifiers: KeyModifiers::NONE,
+            })
+    );
+    assert!(
+        !app.chat_widget
+            .handle_mouse_event(crossterm::event::MouseEvent {
+                kind: crossterm::event::MouseEventKind::Down(crossterm::event::MouseButton::Left),
+                column: u16::MAX,
+                row: u16::MAX,
+                modifiers: KeyModifiers::NONE,
+            })
+    );
+    app.chat_widget.handle_paste("X".to_string());
+
+    assert_eq!(app.chat_widget.composer_text_with_pending(), "abcXdef");
+    Ok(())
